  "bugs": {
    "url": "https://github.com/marsiancba/jWorship/issues"
  },
  "homepage": "https://github.com/marsiancba/jWorship#readme",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "electron": "^41.2.0",
    "eslint": "^10.2.0",
    "typescript": "^6.0.2"
  }
}
