{
  "name": "jworship",
  "version": "4.2.1",
  "description": "Worship presentation software – Electron/TypeScript migration of jWorship",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && cp electron-src/renderer/index.html electron-src/renderer/style.css dist/renderer/",
    "dev": "npm run build && electron .",
    "dev:web": "npm run build && node dist/dev-server.js",
    "start": "electron .",
    "lint": "eslint 'electron-src/**/*.ts'",
    "test": "echo \"No tests configured yet\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marsiancba/jWorship.git"
  },
  "keywords": [
    "worship",
    "presentation",
    "electron",
    "church"
  ],
  "author": "",
